        "DATABASE_PASSWORD": "{{ db_password }}"
      },
      "extra_vars": {
        "db_connection_string": "postgresql://{{ db_username }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}?sslmode={{ db_ssl_mode }}"
